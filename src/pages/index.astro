---
import "../styles/global.css";
const siteBase = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${siteBase}favicon.svg`} />
    <link rel="icon" href={`${siteBase}favicon.ico`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Creds & Co.</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="topbar">
        <a class="brand" href={siteBase}>Creds <span>&</span> Co.</a>
        <nav class="nav" aria-label="Main navigation">
          <a href={siteBase} class="active">Home</a>
          <a href={`${siteBase}draw/`}>Draw</a>
          <a href={`${siteBase}art/`}>Art</a>
        </nav>
        <div class="header-status">
          <span class="credit-pill" id="credit-balance">0 creds</span>
          <button class="primary-btn" type="button" id="daily-reward-btn">Daily reward</button>
        </div>
      </header>

      <main class="container">
        <section class="hero">
          <div class="hero-copy">
            <p class="eyebrow">Art club • drawing • creativity</p>
            <h1>Build a style. Share a story. Earn creds.</h1>
            <p>
              Welcome to Creds & Co., a cozy art community where you draw whatever you want,
              dress your avatar with stylish accessories, and post your best work for the whole club to admire.
            </p>
            <div class="cta-row">
              <a class="primary-btn" href={`${siteBase}draw/`}>Start drawing</a>
              <a class="secondary-btn" href={`${siteBase}art/`}>Visit the art wall</a>
            </div>
          </div>

          <div class="hero-panel">
            <div class="avatar-card">
              <div class="avatar-stage" aria-label="Avatar preview">
                <div class="avatar-silhouette">
                  <svg class="avatar-gear crown" data-accessory="crown" viewBox="0 0 140 180" aria-label="Gold crown"><path d="M36 40 43 18 59 32 70 11 82 32 98 18 105 40Z" fill="#f3b82f" stroke="#99631c" stroke-width="3" stroke-linejoin="round"/><path d="M40 39h61v10H40z" fill="#d58b23"/><circle cx="70" cy="39" r="4" fill="#f06b86"/><circle cx="54" cy="39" r="3" fill="#70c8e8"/><circle cx="86" cy="39" r="3" fill="#70c8e8"/></svg>
                  <svg class="avatar-gear beanie" data-accessory="beanie" viewBox="0 0 140 180" aria-label="Purple knit beanie"><path d="M35 44c1-21 16-35 35-35s34 14 35 35H35Z" fill="#8f6ad9" stroke="#61439e" stroke-width="3"/><path d="M34 39h72v12H34z" rx="6" fill="#b293f1" stroke="#61439e" stroke-width="3"/><path d="M52 14l-2 17m19-22v18m18-13 3 16" stroke="#cdb7ff" stroke-width="3" stroke-linecap="round"/></svg>
                  <svg class="avatar-gear glasses" data-accessory="glasses" viewBox="0 0 140 180" aria-label="Round glasses"><g fill="none" stroke="#372d48" stroke-width="4"><rect x="34" y="45" width="31" height="22" rx="9"/><rect x="75" y="45" width="31" height="22" rx="9"/><path d="M65 52q5-5 10 0M34 50l-7-3m79 3 7-3"/></g><path d="M42 49h15m25 0h15" stroke="#fff" stroke-width="2" opacity=".65"/></svg>
                  <svg class="avatar-gear wings" data-accessory="wings" viewBox="0 0 140 180" aria-label="White feather wings"><path d="M40 89C22 67 5 69 8 89c2 14 14 23 25 27-16-2-26 8-19 18 8 12 26 10 40-4l16-20ZM100 89c18-22 35-20 32 0-2 14-14 23-25 27 16-2 26 8 19 18-8 12-26 10-40-4L70 110Z" fill="#f4f0ff" stroke="#bdb2d5" stroke-width="3" stroke-linejoin="round"/><path d="m18 85 30 25m-27 4 29 9m72-38-30 25m27 4-29 9" stroke="#d3c9e6" stroke-width="2"/></svg>
                  <svg class="avatar-gear scarf" data-accessory="scarf" viewBox="0 0 140 180" aria-label="Striped scarf"><path d="M43 78q27 13 54 0l-4 17q-23 13-46 0Z" fill="#e45f82" stroke="#a83c5e" stroke-width="3"/><path d="m81 92 14 2-1 35q-8 5-15-1Z" fill="#e45f82" stroke="#a83c5e" stroke-width="3"/><path d="m45 82 49 1m-47 8 45 1m-8 13 9 2m-9 10 9 2" stroke="#ffd4dc" stroke-width="3"/></svg>
                  <svg class="avatar-gear cape" data-accessory="cape" viewBox="0 0 140 180" aria-label="Blue cape"><path d="m37 83 33 11 33-11-8 79H45Z" fill="#626acb" stroke="#343c91" stroke-width="3" stroke-linejoin="round"/><path d="m48 91 22 9 22-9-5 61H54Z" fill="#8589ed"/><path d="m60 91 10 8 10-8-10 21Z" fill="#f2c65d"/></svg>
                  <svg class="avatar-gear hoodie" data-accessory="hoodie" viewBox="0 0 140 180" aria-label="Teal hoodie"><path d="M48 82q22-18 44 0l17 11-8 66H39l-8-66Z" fill="#46b7b2" stroke="#277f83" stroke-width="3" stroke-linejoin="round"/><path d="M50 83q20 23 40 0l-7 16H57Z" fill="#d1fbef" stroke="#277f83" stroke-width="3"/><path d="m62 96-2 21m18-21 2 21" stroke="#e1fff5" stroke-width="3" stroke-linecap="round"/><path d="M52 132h36v17H52z" rx="7" fill="#329a98"/></svg>
                  <div class="avatar-head"></div>
                  <div class="avatar-body"></div>
                </div>
              </div>
              <div class="avatar-meta">
                <strong id="welcome-name">Guest artist</strong>
                <span id="avatar-badges">Starter kit</span>
              </div>
            </div>
          </div>
        </section>

        <section class="panel">
          <div class="section-heading">
            <h2>Style your avatar</h2>
            <p>Build a look that fits your art vibe.</p>
          </div>

          <div class="build-grid">
            <div class="avatar-card">
              <div class="avatar-stage" aria-label="Current avatar preview">
                <div class="avatar-silhouette">
                  <svg class="avatar-gear crown" data-accessory="crown" viewBox="0 0 140 180" aria-label="Gold crown"><path d="M36 40 43 18 59 32 70 11 82 32 98 18 105 40Z" fill="#f3b82f" stroke="#99631c" stroke-width="3" stroke-linejoin="round"/><path d="M40 39h61v10H40z" fill="#d58b23"/><circle cx="70" cy="39" r="4" fill="#f06b86"/><circle cx="54" cy="39" r="3" fill="#70c8e8"/><circle cx="86" cy="39" r="3" fill="#70c8e8"/></svg>
                  <svg class="avatar-gear beanie" data-accessory="beanie" viewBox="0 0 140 180" aria-label="Purple knit beanie"><path d="M35 44c1-21 16-35 35-35s34 14 35 35H35Z" fill="#8f6ad9" stroke="#61439e" stroke-width="3"/><path d="M34 39h72v12H34z" rx="6" fill="#b293f1" stroke="#61439e" stroke-width="3"/><path d="M52 14l-2 17m19-22v18m18-13 3 16" stroke="#cdb7ff" stroke-width="3" stroke-linecap="round"/></svg>
                  <svg class="avatar-gear glasses" data-accessory="glasses" viewBox="0 0 140 180" aria-label="Round glasses"><g fill="none" stroke="#372d48" stroke-width="4"><rect x="34" y="45" width="31" height="22" rx="9"/><rect x="75" y="45" width="31" height="22" rx="9"/><path d="M65 52q5-5 10 0M34 50l-7-3m79 3 7-3"/></g><path d="M42 49h15m25 0h15" stroke="#fff" stroke-width="2" opacity=".65"/></svg>
                  <svg class="avatar-gear wings" data-accessory="wings" viewBox="0 0 140 180" aria-label="White feather wings"><path d="M40 89C22 67 5 69 8 89c2 14 14 23 25 27-16-2-26 8-19 18 8 12 26 10 40-4l16-20ZM100 89c18-22 35-20 32 0-2 14-14 23-25 27 16-2 26 8 19 18-8 12-26 10-40-4L70 110Z" fill="#f4f0ff" stroke="#bdb2d5" stroke-width="3" stroke-linejoin="round"/><path d="m18 85 30 25m-27 4 29 9m72-38-30 25m27 4-29 9" stroke="#d3c9e6" stroke-width="2"/></svg>
                  <svg class="avatar-gear scarf" data-accessory="scarf" viewBox="0 0 140 180" aria-label="Striped scarf"><path d="M43 78q27 13 54 0l-4 17q-23 13-46 0Z" fill="#e45f82" stroke="#a83c5e" stroke-width="3"/><path d="m81 92 14 2-1 35q-8 5-15-1Z" fill="#e45f82" stroke="#a83c5e" stroke-width="3"/><path d="m45 82 49 1m-47 8 45 1m-8 13 9 2m-9 10 9 2" stroke="#ffd4dc" stroke-width="3"/></svg>
                  <svg class="avatar-gear cape" data-accessory="cape" viewBox="0 0 140 180" aria-label="Blue cape"><path d="m37 83 33 11 33-11-8 79H45Z" fill="#626acb" stroke="#343c91" stroke-width="3" stroke-linejoin="round"/><path d="m48 91 22 9 22-9-5 61H54Z" fill="#8589ed"/><path d="m60 91 10 8 10-8-10 21Z" fill="#f2c65d"/></svg>
                  <svg class="avatar-gear hoodie" data-accessory="hoodie" viewBox="0 0 140 180" aria-label="Teal hoodie"><path d="M48 82q22-18 44 0l17 11-8 66H39l-8-66Z" fill="#46b7b2" stroke="#277f83" stroke-width="3" stroke-linejoin="round"/><path d="M50 83q20 23 40 0l-7 16H57Z" fill="#d1fbef" stroke="#277f83" stroke-width="3"/><path d="m62 96-2 21m18-21 2 21" stroke="#e1fff5" stroke-width="3" stroke-linecap="round"/><path d="M52 132h36v17H52z" rx="7" fill="#329a98"/></svg>
                  <div class="avatar-head"></div>
                  <div class="avatar-body"></div>
                </div>
              </div>
            </div>

            <div class="accessory-list" id="accessory-list">
              <button class="accessory-item active" type="button" data-accessory="glasses">
                <strong>Glasses</strong>
                <small>Smart and bold</small>
              </button>
              <button class="accessory-item" type="button" data-accessory="beanie">
                <strong>Beanie</strong>
                <small>Warm looks</small>
              </button>
              <button class="accessory-item" type="button" data-accessory="crown">
                <strong>Crown</strong>
                <small>Royal energy</small>
              </button>
              <button class="accessory-item" type="button" data-accessory="wings">
                <strong>Wings</strong>
                <small>Fly like a dream</small>
              </button>
              <button class="accessory-item" type="button" data-accessory="scarf">
                <strong>Scarf</strong>
                <small>Soft colors</small>
              </button>
              <button class="accessory-item" type="button" data-accessory="cape">
                <strong>Cape</strong>
                <small>Hero mode</small>
              </button>
              <button class="accessory-item" type="button" data-accessory="hoodie">
                <strong>Hoodie</strong>
                <small>Cozy style</small>
              </button>
            </div>
          </div>
        </section>

        <section class="panel">
          <div class="section-heading">
            <h2>Accessory shop</h2>
            <p>Spend your creds on better gear.</p>
          </div>

          <div class="shop-grid">
            <article class="shop-item">
              <div class="item-art"><svg viewBox="0 0 140 180" aria-hidden="true"><path d="M36 90 43 55 59 75 70 42 82 75 98 55 105 90Z" fill="#f3b82f" stroke="#99631c" stroke-width="5" stroke-linejoin="round"/><path d="M40 88h61v15H40z" fill="#d58b23"/><circle cx="70" cy="89" r="6" fill="#f06b86"/></svg></div>
              <div class="item-copy">
                <h3>Crown</h3>
                <p>Royal sparkle</p>
              </div>
              <div class="purchase-row">
                <span class="price-tag">80 creds</span>
                <button class="purchase-btn" type="button" data-item="crown" data-price="80">Buy</button>
              </div>
            </article>

            <article class="shop-item">
              <div class="item-art"><svg viewBox="0 0 140 180" aria-hidden="true"><path d="M64 87C43 44 13 45 18 83c3 23 19 38 34 44-23-3-37 12-27 28 11 17 38 15 57-6l13-27Zm12 0c21-43 51-42 46-4-3 23-19 38-34 44 23-3 37 12 27 28-11 17-38 15-57-6l-13-27Z" fill="#f4f0ff" stroke="#bdb2d5" stroke-width="5"/></svg></div>
              <div class="item-copy">
                <h3>Wings</h3>
                <p>Light as air</p>
              </div>
              <div class="purchase-row">
                <span class="price-tag">110 creds</span>
                <button class="purchase-btn" type="button" data-item="wings" data-price="110">Buy</button>
              </div>
            </article>

            <article class="shop-item">
              <div class="item-art"><svg viewBox="0 0 140 180" aria-hidden="true"><g fill="none" stroke="#372d48" stroke-width="8"><rect x="20" y="70" width="43" height="30" rx="12"/><rect x="77" y="70" width="43" height="30" rx="12"/><path d="M63 78q7-8 14 0M20 76 9 70m111 6 11-6"/></g><path d="M28 75h20m38 0h20" stroke="#fff" stroke-width="3" opacity=".65"/></svg></div>
              <div class="item-copy">
                <h3>Glasses</h3>
                <p>Cool observer</p>
              </div>
              <div class="purchase-row">
                <span class="price-tag">50 creds</span>
                <button class="purchase-btn" type="button" data-item="glasses" data-price="50">Buy</button>
              </div>
            </article>

            <article class="shop-item">
              <div class="item-art"><svg viewBox="0 0 140 180" aria-hidden="true"><path d="M25 92c2-37 20-60 45-60s43 23 45 60H25Z" fill="#8f6ad9" stroke="#61439e" stroke-width="6"/><path d="M21 84h98v18H21z" rx="9" fill="#b293f1" stroke="#61439e" stroke-width="6"/><path d="M49 49l-3 25m24-39v27m24-16 4 25" stroke="#cdb7ff" stroke-width="4"/></svg></div>
              <div class="item-copy">
                <h3>Beanie</h3>
                <p>Cozy confidence</p>
              </div>
              <div class="purchase-row">
                <span class="price-tag">60 creds</span>
                <button class="purchase-btn" type="button" data-item="beanie" data-price="60">Buy</button>
              </div>
            </article>
          </div>
        </section>
      </main>
    </div>

    <div class="login-overlay" id="login-overlay">
      <div class="login-card">
        <h2>Welcome to the club</h2>
        <p>Log in to draw, earn creds, and share your creations.</p>
        <form class="login-form" id="login-form">
          <label>
            Display name
            <input id="login-name" type="text" maxlength="22" required />
          </label>
          <label>
            Password
            <input id="login-password" type="password" maxlength="24" placeholder="club123" required />
          </label>
          <button class="primary-btn" type="submit">Enter the club</button>
        </form>
      </div>
    </div>

    <script is:inline>
      const STORAGE_KEY = 'pixel-atelier-profile';
      const defaultProfile = { name: '', password: '', creds: 120, accessories: ['glasses'], claimedAt: '' };
      const profile = JSON.parse(localStorage.getItem(STORAGE_KEY) || JSON.stringify(defaultProfile));
      const balanceNode = document.getElementById('credit-balance');
      const welcomeName = document.getElementById('welcome-name');
      const avatarBadges = document.getElementById('avatar-badges');
      const loginOverlay = document.getElementById('login-overlay');
      const loginForm = document.getElementById('login-form');
      const rewardBtn = document.getElementById('daily-reward-btn');

      function saveProfile() {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(profile));
      }

      function ensureLoggedIn() {
        if (!profile.name || !profile.password) {
          loginOverlay.classList.add('visible');
          return false;
        }
        loginOverlay.classList.remove('visible');
        return true;
      }

      function updateBalance() {
        balanceNode.textContent = `${profile.creds || 0} creds`;
      }

      function renderAvatar() {
        const gearNodes = document.querySelectorAll('.avatar-gear');
        const activeAccessories = new Set(profile.accessories || []);
        gearNodes.forEach((node) => {
          node.classList.toggle('visible', activeAccessories.has(node.dataset.accessory));
        });

        welcomeName.textContent = profile.name || 'Guest artist';
        avatarBadges.textContent = `${(profile.accessories || []).length} accessories`;
      }

      function claimDailyReward() {
        if (!ensureLoggedIn()) return;
        const today = new Date().toDateString();
        if (profile.claimedAt === today) {
          alert('Already claimed today\'s reward partner.');
          return;
        }
        profile.creds += 50;
        profile.claimedAt = today;
        saveProfile();
        updateBalance();
        alert('Daily reward: +50 creds');
      }

      function purchaseAccessory(itemName, price) {
        if (!ensureLoggedIn()) return;
        const hasItem = (profile.accessories || []).includes(itemName);
        if (hasItem) {
          alert('You already own that accessory.');
          return;
        }
        if (profile.creds < price) {
          alert('Not enough creds yet. Try the daily reward!');
          return;
        }
        profile.creds -= price;
        profile.accessories = profile.accessories || [];
        profile.accessories.push(itemName);
        saveProfile();
        renderAvatar();
        updateBalance();
      }

      function bindAccessoryButtons() {
        document.querySelectorAll('.accessory-item').forEach((button) => {
          const accessory = button.dataset.accessory;
          button.classList.toggle('active', (profile.accessories || []).includes(accessory));
          button.addEventListener('click', () => {
            if (!ensureLoggedIn()) return;
            const accessories = profile.accessories || [];
            if (accessories.includes(accessory)) {
              profile.accessories = accessories.filter((item) => item !== accessory);
            } else {
              profile.accessories = [...accessories, accessory];
            }
            saveProfile();
            renderAvatar();
            button.classList.toggle('active', profile.accessories.includes(accessory));
          });
        });

        document.querySelectorAll('.purchase-btn').forEach((button) => {
          button.addEventListener('click', () => purchaseAccessory(button.dataset.item, Number(button.dataset.price)));
        });
      }

      rewardBtn.addEventListener('click', claimDailyReward);

      loginForm.addEventListener('submit', (event) => {
        event.preventDefault();
        const name = document.getElementById('login-name').value.trim();
        const password = document.getElementById('login-password').value.trim();
        if (!name || !password) return;
        profile.name = name;
        profile.password = password;
        if (!Array.isArray(profile.accessories) || !profile.accessories.length) {
          profile.accessories = ['glasses'];
        }
        saveProfile();
        renderAvatar();
        updateBalance();
        loginOverlay.classList.remove('visible');
        loginForm.reset();
      });

      bindAccessoryButtons();
      renderAvatar();
      updateBalance();
      ensureLoggedIn();
    </script>
  </body>
</html>
